    "dev": "node esbuild.config.mjs",
    "prepare:release": "npm run typecheck && npm run test:logic && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.2",
    "obsidian": "latest",
    "typescript": "^5.8.2"
  }
}
