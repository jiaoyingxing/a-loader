{
  "name": "a-plugins",
  "version": "0.4.6",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:logic": "node --experimental-strip-types ./scripts/logic-smoke.ts",
    "build:bundle": "node esbuild.config.mjs production --skip-runtime-sync",
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "prepare:release": "npm run typecheck && npm run test:logic && npm run build:bundle",
    "sync:runtime": "node scripts/sync-runtime-artifacts.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.2",
    "obsidian": "1.12.3",
    "typescript": "^5.8.2"
  }
}
