{
  "name": "a-plugins",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:logic": "node --experimental-strip-types ./scripts/logic-smoke.ts",
